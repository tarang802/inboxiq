# server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# set to 1 when running behind one reverse proxy
TRUST_PROXY=0
# production: path to the built client (client/dist); the api then lives under /api
CLIENT_DIST=

# database (neon connection string)
DATABASE_URL=

# google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
# "units per minute per user" for the gmail api in google cloud > quotas
GMAIL_UNITS_PER_MINUTE=6000

# secrets
TOKEN_ENCRYPTION_KEY=
