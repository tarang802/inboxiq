generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  googleId  String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account  GoogleAccount?
  sessions Session[]
  senders  Sender[]
  syncs    SyncRun[]
}

// id is a sha256 of the cookie token, so a db leak can't be replayed as a login
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GoogleAccount {
  id                    String   @id @default(cuid())
  userId                String   @unique
  encryptedRefreshToken String
  scopes                String
  tokenValid            Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SenderStatus {
  ACTIVE
  KEPT
  IGNORED
  UNSUBSCRIBED
}

model Sender {
  id               String       @id @default(cuid())
  userId           String
  email            String
  name             String?
  domain           String
  messageCount     Int          @default(0)
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  unsubscribeUrl   String?
  unsubscribeMail  String?
  oneClick         Boolean      @default(false)
  status           SenderStatus @default(ACTIVE)
  clutterScore     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId, status])
  @@index([userId, messageCount])
}

enum SyncStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model SyncRun {
  id          String     @id @default(cuid())
  userId      String
  status      SyncStatus @default(QUEUED)
  processed   Int        @default(0)
  total       Int?
  error       String?
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}
